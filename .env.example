# Copy to .env, or run scripts/init-env.sh to generate initialization passwords.
# Configure the existing business MySQL account; its password is never generated here.
# .env is private and excluded from Git and all Docker build contexts.
COMPOSE_PROJECT_NAME=oneflight
APP_VERSION=1.0.0
WEB_PORT=8088
MYSQL_PORT=3307
MYSQL_DATABASE=oneflight
DB_URL=jdbc:mysql://118.31.104.96:31306/oneflight?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员
TZ=Asia/Shanghai
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173

# Optional map providers (public URLs/tokens only; never put source credentials here).
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
MAP_SATELLITE_URL=
MAP_TERRAIN_URL=

# Device/DB/MQTT credentials are backend-only. Blank credentials show "未接入".
# The algorithm catalog is a public read-only API; device deployments also use SOURCE_USERNAME.
SOURCE_GATEWAY_ORIGIN=https://dushu.jing-an.com:32716
SOURCE_GATEWAY_SYSTEM=jingqi
SOURCE_TARGET_HOST=47.96.225.165:32716
SOURCE_TOKEN=
SOURCE_USERNAME=
SOURCE_DUSHU_JDBC_URL=jdbc:mysql://47.96.225.165:31306/dushu
SOURCE_DUSHU_USERNAME=
SOURCE_DUSHU_PASSWORD=
SOURCE_ICOS_JDBC_URL=jdbc:mysql://47.96.225.165:31306/chingchi-icos
SOURCE_ICOS_USERNAME=
SOURCE_ICOS_PASSWORD=
SOURCE_MQTT_URL=tcp://47.96.225.165:31883
SOURCE_MQTT_USERNAME=
SOURCE_MQTT_PASSWORD=
SOURCE_ALGORITHM_ORIGIN=http://47.111.155.82:32052
SOURCE_TIMEOUT_SECONDS=8

# Optional ja-4a identity source. Empty values reuse the dushu host/account with schema ja-4a.
SOURCE_IDENTITY_JDBC_URL=
SOURCE_IDENTITY_USERNAME=
SOURCE_IDENTITY_PASSWORD=

# 4A authenticates accounts; platform business roles/grants remain independently configured.
ONEFLIGHT_AUTH_MODE=local
ONEFLIGHT_TRANSPORT_MODE=https
ONEFLIGHT_BUNDLED_GATEWAY_ENABLED=false
# For the legacy Compose single-IP profile. Packaged start.sh separately exposes
# SERVER_IP for internal services and PUBLIC_IP for browser-facing addresses.
SERVER_IP=
FLIGHT_CONTROL_HTTP_PORT=8089
ONEFLIGHT_LOCAL_MAINTENANCE_ENABLED=false
ONEFLIGHT_FOUR_A_ORIGIN=https://4a.jing-an.com:32712
ONEFLIGHT_FOUR_A_TIMEOUT_SECONDS=8
# Optional first platform administrator: verified immutable 4A userId, never a username or 4A role.
ONEFLIGHT_BOOTSTRAP_FOUR_A_USER_ID=
ONEFLIGHT_PUBLIC_ORIGIN=
FLIGHT_CONTROL_MODE=local
ONEFLIGHT_EMBED_VIEW=native
FLIGHT_CONTROL_ENTRY_PATH=/source/UAV_AIRPORT
# Simple native iframe (mode=direct): use the remote flight platform's own login and interfaces.
FLIGHT_CONTROL_DIRECT_URL=https://dushu.jing-an.com:32716/control-room
# mode=embedded retains the optional proxy/ticket integration below.
FLIGHT_CONTROL_ORIGIN=
# Generate at least 32 random URL-safe characters; backend and gateway use the same value.
FLIGHT_CONTROL_GATEWAY_SECRET=
# Optional dual-host HTTPS gateway, Compose >= 2.24.4. Do not put certificates in Git.
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
GATEWAY_TLS_DIRECTORY=./private/gateway-tls
DUSHU_UPSTREAM_HOST=dushu.jing-an.com
DUSHU_UPSTREAM_PORT=32716
# Leave empty to inherit SOURCE_TARGET_HOST; override only when the flight proxy uses a different target.
DUSHU_TARGET_HOST=

# Only the generated single-Java standalone start.sh uses this network/public-port switch.
ONEFLIGHT_GATEWAY_ENABLED=false
