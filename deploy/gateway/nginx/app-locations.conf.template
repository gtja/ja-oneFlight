    location / {
        proxy_pass http://${ONEFLIGHT_APP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Oneflight-Gateway-Secret '';
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 120s;
    }
    # The bootstrap is available only through the independent flight origin.
    location ~ ^/api/v1/flight-control/(bootstrap|logout-page)$ { return 404; }
