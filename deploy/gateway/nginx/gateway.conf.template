# The request URI, query, cookies and Authorization headers are deliberately absent.
log_format oneflight_safe '$remote_addr [$time_local] $host $request_method $uri $status $body_bytes_sent';
access_log ${NGINX_RUNTIME_DIR}/logs/access.log oneflight_safe;
# Nginx upstream error diagnostics can contain complete ticket/callback URLs.
error_log /dev/null;
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
map $http_origin $oneflight_source_origin { '' ''; default 'https://${DUSHU_UPSTREAM_HOST}:${DUSHU_UPSTREAM_PORT}'; }
include ${NGINX_RUNTIME_DIR}/entry-maps.conf;

server {
    listen ${ONEFLIGHT_REDIRECT_LISTEN_PORT} default_server;
    server_name _;
    return 444;
}
server {
    listen ${ONEFLIGHT_REDIRECT_LISTEN_PORT};
    server_name ${ONEFLIGHT_PUBLIC_HOST};
    return 308 ${ONEFLIGHT_PUBLIC_ORIGIN}$request_uri;
}
server {
    listen ${ONEFLIGHT_REDIRECT_LISTEN_PORT};
    server_name ${FLIGHT_CONTROL_HOST};
    return 308 ${FLIGHT_CONTROL_ORIGIN}$request_uri;
}
server {
    listen ${ONEFLIGHT_HTTPS_LISTEN_PORT} ssl default_server;
    ssl_reject_handshake on;
}
server {
    listen ${ONEFLIGHT_HTTPS_LISTEN_PORT} ssl;
    server_name ${ONEFLIGHT_PUBLIC_HOST};
    ssl_certificate /etc/oneflight/tls/oneflight.fullchain.pem;
    ssl_certificate_key /etc/oneflight/tls/oneflight.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header Referrer-Policy 'no-referrer' always;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 100m;
    include ${NGINX_RUNTIME_DIR}/app-locations.conf;
}
server {
    listen ${FLIGHT_HTTPS_LISTEN_PORT} ssl;
    server_name ${FLIGHT_CONTROL_HOST};
    ssl_certificate /etc/oneflight/tls/flight-control.fullchain.pem;
    ssl_certificate_key /etc/oneflight/tls/flight-control.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header Referrer-Policy 'no-referrer' always;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "frame-ancestors ${ONEFLIGHT_PUBLIC_ORIGIN}" always;
    add_header Cache-Control $oneflight_document_cache_control always;
    client_max_body_size 100m;

    include ${NGINX_RUNTIME_DIR}/flight-locations.conf;
}
